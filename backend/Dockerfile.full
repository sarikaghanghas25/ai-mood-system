# FULL backend image: the best model (sentence embeddings + torch), needs ~1GB RAM.
# For Hugging Face Spaces (paid), Google Cloud Run, or any host with 1GB+.
#   docker build -f Dockerfile.full -t mood-api .
# The free 512MB hosts use the default Dockerfile (light model) instead.
FROM python:3.11-slim

# Spaces runs the container as user 1000
RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH \
    HF_HOME=/home/user/.cache/huggingface \
    PYTHONUNBUFFERED=1

WORKDIR /home/user/app

COPY --chown=user requirements.txt .
# CPU-only torch is ~200MB instead of ~2GB with CUDA
RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    -r requirements.txt

# Download the embedding model now, so the first request isn't a 470MB download
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2')"

COPY --chown=user . .

EXPOSE 7860
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-7860}"]
